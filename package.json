{
  "name": "agentic-video-studio",
  "version": "0.2.0",
  "private": true,
  "description": "Deterministic, code-generated technical explainers with Remotion and Three.js",
  "type": "module",
  "bin": {
    "agentic-video-studio": "bin/agentic-video-studio.mjs"
  },
  "files": [
    "bin",
    "scripts",
    "src",
    "remotion.config.ts",
    "tsconfig.json",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts AgenticDevelopment out/agentic-development.mp4",
    "render:sample": "remotion render src/index.ts AgenticDevelopment out/sample.mp4 --frames=0-29 --scale=0.5 --concurrency=1",
    "still": "remotion still src/index.ts AgenticDevelopment out/poster.png --frame=450",
    "render:pillars": "remotion render src/index.ts ManufacturingPillars out/manufacturing-pillars.mp4",
    "render:pillars:sample": "remotion render src/index.ts ManufacturingPillars out/manufacturing-pillars-sample.mp4 --frames=180-209 --scale=0.5 --concurrency=1",
    "still:pillars": "remotion still src/index.ts ManufacturingPillars out/manufacturing-pillars.png --frame=960",
    "verify:render": "node scripts/verify-render.mjs",
    "verify:pillars": "node scripts/verify-pillars.mjs",
    "render:coffee": "remotion render src/index.ts FrenchPressCoffee out/french-press-coffee.mp4",
    "render:coffee:sample": "remotion render src/index.ts FrenchPressCoffee out/french-press-coffee-sample.mp4 --frames=1170-1199 --scale=0.5 --concurrency=1",
    "still:coffee": "remotion still src/index.ts FrenchPressCoffee out/french-press-coffee.png --frame=1215",
    "verify:coffee": "node scripts/verify-coffee.mjs",
    "render:rag": "remotion render src/index.ts RagFlow out/rag-flow.mp4",
    "render:rag:sample": "remotion render src/index.ts RagFlow out/rag-flow-sample.mp4 --frames=1560-1589 --scale=0.5 --concurrency=1",
    "still:rag": "remotion still src/index.ts RagFlow out/rag-flow.png --frame=1650",
    "verify:rag": "node scripts/verify-rag.mjs",
    "render:oauth": "remotion render src/index.ts OAuthFlows out/oauth-flows.mp4",
    "render:oauth:sample": "remotion render src/index.ts OAuthFlows out/oauth-flows-sample.mp4 --frames=1530-1589 --scale=0.5 --concurrency=1",
    "still:oauth": "remotion still src/index.ts OAuthFlows out/oauth-flows.png --frame=3525",
    "verify:oauth": "node scripts/verify-oauth.mjs",
    "browser:install": "puppeteer browsers install chrome",
    "browser:check": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@remotion/bundler": "4.0.521",
    "@remotion/cli": "4.0.521",
    "@remotion/renderer": "4.0.521",
    "@remotion/three": "4.0.521",
    "gsap": "3.15.0",
    "puppeteer": "25.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.521",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.180.0",
    "typescript": "5.9.3"
  }
}
